{
  "name": "vislex-web",
  "version": "1.0.0",
  "description": "VisLex — AI 生图参数视觉词典",
  "type": "module",
  "scripts": {
    "dev:server": "npx tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "build:github": "vite build --base=/vislex-web/",
    "start": "node --loader tsx/esm server/index.ts",
    "seed": "npx tsx server/seed.ts",
    "setup": "npm run seed && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "fastify": "^5.2.1",
    "@fastify/static": "^8.0.3",
    "@fastify/cors": "^10.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
